FROM python:3.11-slim

WORKDIR /app

# Install build dependencies
RUN pip install --no-cache-dir build pytest pytest-cov coverage pytest-benchmark psutil

# Copy source
COPY . .

# Build the package
RUN python -m build

# Install the built wheel
RUN pip install dist/*.whl

# Install all optional dependencies (extras)
RUN pip install ".[all,performance]"

# Clean up source files, keeping only tests and benchmarks
# This ensures we test the installed package, not the source
RUN mkdir /tmp/keep && \
    mv tests /tmp/keep/ && \
    mv benchmark /tmp/keep/ && \
    rm -rf * && \
    mv /tmp/keep/* . && \
    rmdir /tmp/keep

# Default command runs unit tests (excluding integration and benchmark tests)
CMD ["pytest", "tests", "--ignore=tests/mqtt", "--ignore=tests/redis", "--ignore=tests/benchmarks"]
